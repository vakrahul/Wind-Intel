# WINDLINE — Environment Configuration Example (Do not commit real secrets)

# Backend Settings
WINDLINE_APP_NAME="WINDLINE — Wind Forecast Intelligence API"
WINDLINE_APP_VERSION="1.0.0"
WINDLINE_ENV="development"
ELEXON_BASE_URL="https://data.elexon.co.uk/bmrs/api/v1"
ELEXON_HTTP_TIMEOUT=45.0
ELEXON_HTTP_MAX_RETRIES=3
EVALUATION_START_DATE="2026-01-01"
EVALUATION_END_DATE="2026-01-31"
DEFAULT_CUTOFF_TIME_LONDON="11:00"
DEFAULT_CUTOFF_DAY_OFFSET=-1
MAPE_MIN_ACTUAL_MW=100.0
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080"

# Frontend Settings
# Leave empty when using Vite dev proxy or Docker Nginx reverse proxy; set to deployed backend URL on Vercel
VITE_API_BASE_URL=""
